# URL del proyecto Supabase
# Supabase → Settings → API → Project URL
SUPABASE_URL=https://<project-ref>.supabase.co

# Clave anon/service del proyecto Supabase
# Supabase → Settings → API → Project API keys → anon public (o service_role para uso en servidor)
SUPABASE_KEY=<tu-supabase-key>

# Zona horaria para el cron de las 09:00
TZ=America/Argentina/Buenos_Aires

# Puerto HTTP para health check (Railway lo inyecta automáticamente)
PORT=3000

# Números reales de los repartidores (solo dígitos, sin + ni espacios)
# Formato Argentina: 549 + código de área + número. Ej: 5492396432617
DRIVER_1_PHONE=
DRIVER_2_PHONE=
DRIVER_3_PHONE=

# Teléfono del administrador
ADMIN_PHONE=

# Chat ID del grupo de administración para pedidos sin repartidor
# El bot lo loguea automáticamente cuando recibe un mensaje del grupo
# Formato: XXXXXXXXXX-XXXXXXXXXX@g.us
NOTIFY_GROUP_ID=
