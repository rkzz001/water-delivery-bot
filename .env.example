# Zona horaria para el cron de las 09:00
TZ=America/Argentina/Buenos_Aires

# Puerto HTTP para health check (Railway/Render lo inyectan automáticamente)
PORT=3000

# Números reales de los repartidores (solo dígitos, sin + ni espacios)
# Formato: código de país + número. Ejemplo Argentina: 5491112345678
DRIVER_1_PHONE=
DRIVER_2_PHONE=
DRIVER_3_PHONE=
